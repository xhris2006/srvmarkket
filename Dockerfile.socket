# ─── SOCKET.IO SERVER DOCKERFILE ──────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Install only production deps. Fall back to npm install when no lockfile is present.
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

COPY server/ ./server/

EXPOSE 3001

ENV NODE_ENV=production

CMD ["node", "server/socket.mjs"]
